    // -------------------------------------------------------------
    // TAB 4: QUANTIZATION & PHYSICS
    // -------------------------------------------------------------
    function calculateQuantization() {
      const r = parseFloat(document.getElementById('quantRVal').value) || 0;
      const s = parseFloat(document.getElementById('quantSVal').value) || 0.01;
      const z = 0; // zero point assuming symmetric

      const q = Math.round(r / s) + z;
      const clampedQ = Math.max(-128, Math.min(127, q));

      document.getElementById('quantResultQ').textContent = clampedQ;
    }

    function initMinimaChart() {
      const ctx = document.getElementById('minimaChart').getContext('2d');
      minimaChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: [-4, -3, -2, -1, 0, 1, 2, 3, 4],
          datasets: [
            {
              label: 'PTQ (Narrow Minima - 오차 취약)',
              data: [18, 12, 6, 1, 0, 1, 7, 14, 22],
              borderColor: '#f43f5e',
              borderWidth: 2,
              tension: 0.4
            },
            {
              label: 'QAT (Wide Minima - 노이즈 강건)',
              data: [5, 2, 0.5, 0.1, 0, 0.1, 0.5, 2, 5],
              borderColor: '#10b981',
              borderWidth: 3,
              tension: 0.4
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom' } },
          scales: {
            y: { title: { display: true, text: 'Loss (손실)' } },
            x: { title: { display: true, text: '가중치 양자화 노이즈 오차' } }
          }
        }
      });
    }

    function updatePhysicsCalc() {
      const speedKmH = parseFloat(document.getElementById('speedInput').value);
      const latencyMs = parseFloat(document.getElementById('latencyInput').value);

      document.getElementById('speedValText').textContent = `${speedKmH} km/h`;
      document.getElementById('latencyValText').textContent = `${latencyMs} ms`;

      // v (m/s) = speed / 3.6
      const mPerSec = speedKmH / 3.6;
      const cmPerMs = (mPerSec * 100) / 1000;
      const totalShiftCm = cmPerMs * latencyMs;
      const totalShiftM = totalShiftCm / 100;

      document.getElementById('metersPerSec').textContent = `${mPerSec.toFixed(2)} m/s`;
      document.getElementById('cmPerMs').textContent = `${cmPerMs.toFixed(2)} cm`;
      document.getElementById('totalShiftDist').textContent = `${totalShiftCm.toFixed(1)} cm (${totalShiftM.toFixed(2)}m)`;
    }

    // -------------------------------------------------------------
    // TAB 5: DEEPSTREAM & RE-ID SIMULATION
    // -------------------------------------------------------------
    function inspectDsNode(type) {
      const titleEl = document.getElementById('dsNodeInspectTitle');
      const descEl = document.getElementById('dsNodeInspectDesc');

      const data = {
        streammux: {
          title: "노드 상세: gst-nvstreammux (Stream Aggregator)",
          desc: "N개의 RTSP 비디오 입력을 지정된 배치 크기(Batch Size = N)로 동기화 압축합니다. 모든 프레임은 NVMM GPU 텐서 메모리로 직접 바인딩되어 CPU 간 전송 병목이 전혀 발생하지 않습니다."
        },
        infer: {
          title: "노드 상세: gst-nvinfer (TensorRT Primary & Secondary)",
          desc: "Primary GIE에서는 YOLOv10/v12 모델로 차량 및 번호판 BBox를 탐지하고, Cropped 영역을 Secondary GIE로 넘겨 SVTR/PARSeq OCR 인스턴스를 병열 구동합니다."
        },
        tracker: {
          title: "노드 상세: gst-nvtracker (GPU Multi-Object Tracker)",
          desc: "매 프레임 딥러닝 탐지를 실행하지 않더라도 저수준 NvDCF 궤적 필터를 사용하여 동일 차량에 유니크 ID(Track ID)를 안정적으로 유지합니다."
        },
        analytics: {
          title: "노드 상세: gst-nvdsanalytics (Business Logic Engine)",
          desc: "가상의 ROI 라인을 넘는 역주행, 속도 측정 카운팅, 과속 차량 번호판 캡처 이벤트를 JSON 메타데이터(Kafka/MQTT)로 송출합니다."
        }
      };

      const info = data[type];
      titleEl.textContent = info.title;
      descEl.textContent = info.desc;
    }

    let reidCarX = -100;
    function initReidCanvas() {
      const canvas = document.getElementById('reidCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      canvas.width = canvas.parentElement.clientWidth;
      canvas.height = canvas.parentElement.clientHeight;

      ctx.fillStyle = '#090d16';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }

    function toggleReidOcclusionSim() {
      reidSimRunning = !reidSimRunning;
      const btn = document.getElementById('reidSimBtn');
      if (reidSimRunning) {
        btn.textContent = '시뮬레이션 정지';
        btn.className = 'bg-rose-600 hover:bg-rose-700 text-white font-medium text-xs px-4 py-2 rounded-lg transition shadow-sm';
        reidCarX = -80;
        animateReidSim();
      } else {
        btn.textContent = '시뮬레이션 시작 / 정지';
        btn.className = 'bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-xs px-4 py-2 rounded-lg transition shadow-sm';
        if (reidAnimId) cancelAnimationFrame(reidAnimId);
      }
    }

    function animateReidSim() {
      if (!reidSimRunning) return;
      const canvas = document.getElementById('reidCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Background Road
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Road Lane Lines
      ctx.strokeStyle = '#334155';
      ctx.setLineDash([15, 15]);
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(0, canvas.height / 2);
      ctx.lineTo(canvas.width, canvas.height / 2);
      ctx.stroke();
      ctx.setLineDash([]);

      // Move Target Car
      reidCarX += 2.5;
      if (reidCarX > canvas.width + 100) reidCarX = -80;

      // Draw Blocking Truck
      const truckX = canvas.width / 2 - 30;
      ctx.fillStyle = '#475569';
      ctx.fillRect(truckX, canvas.height / 2 - 40, 120, 80);
      ctx.fillStyle = '#94a3b8';
      ctx.font = '10px font-mono-code';
      ctx.fillText('대형 화물차 (Occlusion Barrier)', truckX + 5, canvas.height / 2 - 45);

      // Draw Target Car
      ctx.fillStyle = '#0284c7';
      ctx.fillRect(reidCarX, canvas.height / 2 - 20, 70, 35);

      // Bounding Box on Target Car
      ctx.strokeStyle = '#38bdf8';
      ctx.lineWidth = 2;
      ctx.strokeRect(reidCarX - 2, canvas.height / 2 - 22, 74, 39);

      // Label Track ID
      ctx.fillStyle = '#38bdf8';
      ctx.font = 'bold 11px font-mono-code';
      ctx.fillText('ID: #Vehicle-802', reidCarX, canvas.height / 2 - 27);

      // Check if blocked by truck
      const isBlocked = reidCarX + 70 > truckX && reidCarX < truckX + 120;

      const plateStatus = document.getElementById('reidPlateStatus');
      const confStatus = document.getElementById('reidConfidence');

      if (isBlocked) {
        plateStatus.textContent = '가림 발생 (OCR 이탈)';
        plateStatus.className = 'font-bold text-rose-500 block mt-0.5';
        confStatus.textContent = '96.2% Match (Re-ID 유지)';
        confStatus.className = 'font-bold text-indigo-400 font-mono-code block mt-0.5';
      } else {
        plateStatus.textContent = '선명함 (OCR: 52나 1984)';
        plateStatus.className = 'font-bold text-emerald-600 block mt-0.5';
        confStatus.textContent = '99.4% Match';
        confStatus.className = 'font-bold text-indigo-600 font-mono-code block mt-0.5';
      }

      reidAnimId = requestAnimationFrame(animateReidSim);
    }

    // Window Init
    window.addEventListener('load', () => {
      switchTab('tab-overview');
    });

    window.addEventListener('resize', () => {
      if (currentTab === 'tab-ocr') drawPlateCanvas();
      if (currentTab === 'tab-deepstream') initReidCanvas();
    });
  </script>
