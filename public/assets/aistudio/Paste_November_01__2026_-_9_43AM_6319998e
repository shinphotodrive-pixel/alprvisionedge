    function runDistractorSim() {
      const type = document.getElementById('distractorSelect').value;
      const yoloBar = document.getElementById('yolo-distractor-bar');
      const yoloText = document.getElementById('yolo-distractor-score');
      const rtdetrBar = document.getElementById('rtdetr-distractor-bar');
      const rtdetrText = document.getElementById('rtdetr-distractor-score');

      const scores = {
        night_glare: { yolo: 78.4, rtdetr: 94.2 },
        signboard: { yolo: 82.1, rtdetr: 96.8 },
        occlusion: { yolo: 71.5, rtdetr: 91.0 }
      };

      const s = scores[type];
      yoloBar.style.width = s.yolo + '%';
      yoloText.textContent = `탐지율 ${s.yolo}%`;
      rtdetrBar.style.width = s.rtdetr + '%';
      rtdetrText.textContent = `탐지율 ${s.rtdetr}%`;
    }

    // -------------------------------------------------------------
    // TAB 3: OCR CANVAS & RESTORATION LAB
    // -------------------------------------------------------------
    function drawPlateCanvas() {
      const canvas = document.getElementById('ocrPlateCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');

      const stn = document.getElementById('toggleSTN').checked;
      const clahe = document.getElementById('toggleCLAHE').checked;
      const sr = document.getElementById('toggleESRGAN').checked;

      // Background Fill
      ctx.save();
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Border Plate Frame
      ctx.strokeStyle = '#000000';
      ctx.lineWidth = 4;
      ctx.strokeRect(4, 4, canvas.width - 8, canvas.height - 8);

      // Transformations
      ctx.translate(canvas.width / 2, canvas.height / 2);

      if (!stn) {
        // Skew / Rotate if STN OFF
        ctx.rotate((-12 * Math.PI) / 180);
      }

      // Draw License Text
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      
      let fontQuality = sr ? 'bold 36px "Pretendard", sans-serif' : '30px "Pretendard", sans-serif';
      ctx.font = fontQuality;
      ctx.fillStyle = clahe ? '#000000' : '#475569';

      ctx.fillText('370가 8294', 0, 0);

      // Noise simulation if low quality
      if (!clahe && !sr) {
        ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
        ctx.fillRect(-150, -30, 300, 60);
      }

      ctx.restore();
    }

    function updatePlateRestoration() {
      drawPlateCanvas();

      const stn = document.getElementById('toggleSTN').checked;
      const clahe = document.getElementById('toggleCLAHE').checked;
      const sr = document.getElementById('toggleESRGAN').checked;
      const engine = document.getElementById('ocrEngineSelect').value;

      let cer = 28.5;
      if (stn) cer -= 8.0;
      if (clahe) cer -= 6.5;
      if (sr) cer -= 7.0;

      if (engine === 'PARSeq') cer -= 3.0;
      if (engine === 'SVTR') cer -= 4.0;

      cer = Math.max(0.5, cer);

      const cerEl = document.getElementById('labCerScore');
      const predEl = document.getElementById('ocrPredictedText');

      cerEl.textContent = `${cer.toFixed(1)}% (${cer < 5 ? '우수' : cer < 15 ? '보통' : '열화'})`;

      if (cer < 3.0) {
        predEl.textContent = '370가 8294 (100% 일치)';
        predEl.className = 'font-mono-code font-bold text-emerald-400 text-sm tracking-widest';
      } else if (cer < 10.0) {
        predEl.textContent = '370가 8294 (정확)';
        predEl.className = 'font-mono-code font-bold text-sky-400 text-sm tracking-widest';
      } else {
        predEl.textContent = '370가 829? (미흡)';
        predEl.className = 'font-mono-code font-bold text-rose-400 text-sm tracking-widest';
      }
    }

