              max: 60
            },
            y1: {
              type: 'linear',
              display: true,
              position: 'right',
              title: { display: true, text: 'Latency (ms)' },
              grid: { drawOnChartArea: false },
              min: 0,
              max: 6
            }
          }
        }
      });
    }

    function updateDetectionChart() {
      const val = document.getElementById('detChartMetricSelect').value;
      if (!detChart) return;

      if (val === 'ap_vs_latency') {
        detChart.data.datasets[0].label = 'mAP (%)';
        detChart.data.datasets[0].data = detData.map(d => d.ap);
        detChart.data.datasets[1].label = 'Latency (ms)';
        detChart.data.datasets[1].data = detData.map(d => d.latency);
        detChart.options.scales.y.title.text = 'COCO mAP (%)';
        detChart.options.scales.y1.title.text = 'Latency (ms)';
      } else {
        detChart.data.datasets[0].label = 'Parameters (M)';
        detChart.data.datasets[0].data = detData.map(d => d.params);
        detChart.data.datasets[1].label = 'FLOPs (G)';
        detChart.data.datasets[1].data = detData.map(d => d.flops);
        detChart.options.scales.y.title.text = 'Parameters (M)';
        detChart.options.scales.y1.title.text = 'FLOPs (GFLOPs)';
