    function runPipelineSimulation() {
      let currentStep = 1;
      if (pipelineInterval) clearInterval(pipelineInterval);
      
      pipelineInterval = setInterval(() => {
        selectPipelineStep(currentStep);
        currentStep++;
        if (currentStep > 5) {
          clearInterval(pipelineInterval);
        }
      }, 900);
    }

    function resetPipelineSim() {
      if (pipelineInterval) clearInterval(pipelineInterval);
      selectPipelineStep(1);
    }

    // -------------------------------------------------------------
    // TAB 2: DETECTION CHART & DISTRACTOR SIM
    // -------------------------------------------------------------
    const detData = [
      { model: 'YOLOv8n', ap: 37.3, latency: 0.99, params: 3.2, flops: 8.7, nms: true },
      { model: 'YOLOv8x', ap: 53.9, latency: 3.53, params: 68.2, flops: 257.8, nms: true },
      { model: 'YOLOv10-N', ap: 39.5, latency: 1.84, params: 2.3, flops: 6.7, nms: false },
      { model: 'YOLOv12-N', ap: 41.2, latency: 1.20, params: 2.6, flops: 6.5, nms: true },
      { model: 'YOLOv12-M', ap: 52.1, latency: 2.40, params: 20.1, flops: 68.0, nms: true },
      { model: 'RT-DETR-R18', ap: 46.5, latency: 4.58, params: 20.0, flops: 60.0, nms: false }
    ];

    function initDetectionChart() {
      const ctx = document.getElementById('detectionChart').getContext('2d');
      
      detChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: detData.map(d => d.model),
          datasets: [
            {
              label: 'mAP (%)',
              data: detData.map(d => d.ap),
              borderColor: '#0284c7',
              backgroundColor: 'rgba(2, 132, 199, 0.1)',
              borderWidth: 3,
              fill: true,
              yAxisID: 'y'
            },
            {
              label: 'Latency (ms)',
              data: detData.map(d => d.latency),
              borderColor: '#f59e0b',
              backgroundColor: '#f59e0b',
              borderWidth: 2,
              pointStyle: 'rectRot',
              pointRadius: 6,
              yAxisID: 'y1'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
